# ───────────────────────────────────────────────────────────────
# VENOM MD BOT configuration
# Copy this file to .env locally. Never commit real secrets.
# ───────────────────────────────────────────────────────────────

# Brand
BOT_NAME=VENOM MD BOT
OWNER_NAME=TAPRUSH EMP (Micheal)
OWNER_NUMBER=2348021016309
DESCRIPTION=Fast, secure and powerful WhatsApp automation.
PACKNAME=VENOM MD BOT
AUTHOR=TAPRUSH EMP (Micheal)
TIMEZONE=Africa/Lagos

# Commands
PREFIX=.
# Multiple initial prefixes can be comma-separated with PREFIXES=.,!,/
COMMAND_MODE=public

# Private session credential from the completed VENOM pairing website.
# Never paste this value into chat, logs, screenshots or source control.
SESSION_ID=
SESSION_NAMESPACE=venom
SESSION_SITE_URL=https://session-site-2odn.onrender.com

# Optional MongoDB storage. Recommended on hosts with ephemeral filesystems.
# MONGODB and MONGO_URI are also accepted aliases.
DATABASE_URL=
MONGO_DB=venom

# Optional AI providers. Add only the keys you use; keep every value private.
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
COHERE_API_KEY=

# Safe automation defaults
AUTO_READ=false
AUTO_READ_STATUS=false
ALWAYS_ONLINE=false
REJECT_CALL=true
COMMAND_REACT=true
MEDIA_MAX_MB=32

# Server/logging
PORT=10000
TRUST_PROXY=false
LOG_LEVEL=info
BAILEYS_LOG_LEVEL=silent
# FFMPEG_PATH=/usr/bin/ffmpeg
