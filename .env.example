# VENOM MD BOT configuration
# Copy this file to .env. Never commit your real .env or API keys.

# Command prefix. Default: .
PREFIX=.

# Deployment owners/moderators, digits only. Separate multiple numbers with commas.
# The permanent public creator remains TAPRUSH EMP (Micheal).
MODS=2348021016309

# Optional MongoDB connection string for persistent data and remote session backup.
# VENOM starts without it using local JSON storage and local session files. Use
# MongoDB Atlas or another private instance when you want persistence on Render.
# Production hosts do not provide MongoDB at 127.0.0.1:27017. MONGO_URI is also accepted.
MONGODB=mongodb://127.0.0.1:27017/venom
# MONGO_URI=

# Safe name for this bot's local/MongoAuth session storage.
SESSION_NAMESPACE=venom

# Private credential generated by the existing external VENOM session site:
# https://session-site-2odn.onrender.com
# Leave blank when this namespace already has a linked local/MongoAuth session.
# Never commit or share the real value. Later this will accept the site's short,
# one-time token after that same external service is upgraded.
SESSION_ID=

# Sticker metadata.
PACKNAME=VENOM MD BOT
AUTHOR=by: TAPRUSH EMP (Micheal)

# Optional AI/API keys. Multiple values may be comma-separated.
GEMINI_API=
OPENAI_API=
CLAUDE_API=
TENOR_API_KEY=
OPENWEATHER_API_KEY=
PIXABAY_API_KEY=
TIKTOK_API_KEY=
# Optional: override only when using a compatible, trusted TikTok API provider.
TIKTOK_API_BASE_URL=https://kelvdraapi.domku.xyz/

# HTTP server. Set TRUST_PROXY=true only behind one trusted reverse proxy.
PORT=10000
TRUST_PROXY=false

# Maintenance and watchdog tuning.
GC_INTERVAL_MINUTES=30
WATCHDOG_INTERVAL_SECONDS=60
MESSAGE_CACHE_TTL_MINUTES=360
MESSAGE_CACHE_MAX_PER_CHAT=500
# Maximum inbound and downloaded media size in megabytes.
MEDIA_MAX_MB=64
# Optional FFmpeg binary path; otherwise ffmpeg-static or system ffmpeg is used.
FFMPEG_PATH=
